<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center mt-4">
  <!-- Title -->
  <div class="col-12 col-md-10 col-lg-8">
    <h3 class="mb-3"><%= listing.title %></h3>
  </div>

  <!-- Listing Card -->
  <div class="col-12 col-md-10 col-lg-8">
    <div class="card show-card listing-card shadow-sm">
      <img 
        src="<%= listing.image.url %>"
        class="card-img-top show-img"
        alt="listing_image"
      />

      <div class="card-body p-3 p-md-4">
        <p class="card-text"><strong>Owned by</strong> <i><%= listing.owner.username %></i></p>
        <p class="card-text"><%= listing.description %></p>
        <p class="card-text">&#8377; <%= listing.price.toLocaleString("en-IN") %></p>
        <p class="card-text"><%= listing.location %></p>
        <p class="card-text"><%= listing.country %></p>

        <% if(currUser && listing.owner._id.equals(currUser._id)) { %> 
          <div class="btns mt-4">
            <a href="/listings/<%= listing._id %>/edit"
               class="btn btn-dark edit-btn-custom">
              Edit
            </a>

            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="m-0">
              <button class="btn btn-dark delete-btn-custom">Delete</button>
            </form>
          </div> 
        <% } %>
      </div>
    </div>
  </div>

  <!-- Review Section -->
  <div class="col-12 col-md-10 col-lg-8 mt-4 mb-4">
    <hr>

    <% if(currUser) { %>
      <h4 class="mb-3">Leave a Review</h4>

      <form action="/listings/<%= listing._id %>/reviews" 
            method="POST" 
            novalidate 
            class="needs-validation">

        <div class="mb-3">
          <label for="rating" class="form-label">Rating</label> 
          <fieldset class="starability-slot">
            <input 
              type="radio" 
              id="no-rate" 
              class="input-no-rate" 
              name="review[rating]" 
              value="1" 
              checked 
              aria-label="No rating." 
            />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" required />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>

        <div class="mb-3">
          <label for="comment" class="form-label">Comments</label>
          <textarea 
            name="review[comment]" 
            id="comment" 
            rows="5"
            class="form-control"
            required
          ></textarea>
          <div class="invalid-feedback">Please submit some comments for review</div>
        </div>

        <button class="btn btn-outline-dark">Submit</button>
      </form>

      <hr class="my-4">
    <% } %>

    <h5 class="mb-3"><b>All Reviews</b></h5>

    <div class="row review-row">
      <% for(review of listing.reviews) { %>
        <div class="col-12 col-sm-6 mb-3">
          <div class="card review-card h-100">
            <div class="card-body">
              <h5 class="card-title review-username">@<%= review.author.username %></h5>

              <p class="starability-result card-text mb-2"
                 data-rating="<%= review.rating %>">
              </p>

              <p class="card-text review-comment"><%= review.comment %></p>

              <form class="mt-3"
                    method="POST"
                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                <button class="btn btn-sm btn-dark review-delete-btn">Delete</button>
              </form>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>